generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  designation    String   @default("WARDEN") // e.g., WARDEN, RESI_WARDEN, ATTENDANT
  
  // Optional for staff living in campus
  hostel_name    String?
  room_number    String?
  
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  approvedLeaves Leave[]  @relation("ApprovedLeaves")
}

model Hosteller {
  id               String   @id @default(uuid())
  roll_number      String   @unique
  name             String
  email            String   @unique
  password         String
  dob              DateTime
  gender           String

  phone            String   @default("")
  guardian_name    String?
  guardian_contact String   @default("")

  hostel_name      String
  room_number      String
  block            String?
  floor            String?
  
  total_working_days Int @default(0)
  total_present_days Int @default(0)

  image_url        String?
  status           String   @default("active")
  current_location String   @default("INSIDE")
  last_entry_time  DateTime?
  
  absent_without_leave_count Int @default(0)
  total_absent_count         Int @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  leaves            Leave[]
  scanEvents        ScanEvent[]
  attendanceRecords AttendanceRecord[]
}

model Leave {
  id           String    @id @default(uuid())
  hostellerId  String
  start_date   DateTime
  end_date     DateTime
  reason       String
  status       String    @default("pending")
  approvedById String?
  createdAt    DateTime  @default(now())
  
  approvedBy   Admin?      @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  hosteller    Hosteller   @relation(fields: [hostellerId], references: [id], onDelete: Cascade)
}

model ScanEvent {
  id               String    @id @default(uuid())
  hostellerId      String
  timestamp        DateTime
  type             String
  ocr_confidence   Float?
  model_confidence Float?
  camera_id        String
  createdAt        DateTime  @default(now())
  
  hosteller        Hosteller @relation(fields: [hostellerId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  hostellerId String
  date        DateTime
  status      String
  createdAt   DateTime @default(now())
  
  hosteller   Hosteller @relation(fields: [hostellerId], references: [id], onDelete: Cascade)

  @@unique([hostellerId, date])
}
