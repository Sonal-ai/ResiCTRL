generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  designation    String   @default("WARDEN") // e.g., WARDEN, RESI_WARDEN, ATTENDANT
  
  // Optional for staff living in campus
  hostel_name    String?
  room_number    String?
  
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  approvedLeaves      Leave[]          @relation("ApprovedLeaves")
  resolvedComplaints  Complaint[]      @relation("ResolvedComplaints")
  announcements       Announcement[]   @relation("CreatedAnnouncements")
}

model Hosteller {
  id               String   @id @default(uuid())
  roll_number      String   @unique
  name             String
  email            String   @unique
  password         String
  dob              DateTime
  gender           String

  phone            String   @default("")
  guardian_name    String?
  guardian_contact String   @default("")

  hostel_name      String
  room_number      String
  block            String?
  floor            String?
  
  total_working_days Int @default(0)
  total_present_days Int @default(0)

  image_url        String?
  status           String   @default("active")
  current_location String   @default("INSIDE")
  last_entry_time  DateTime?
  
  absent_without_leave_count Int @default(0)
  total_absent_count         Int @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  leaves            Leave[]
  scanEvents        ScanEvent[]
  attendanceRecords AttendanceRecord[]
  complaints        Complaint[]
  candidacies       Candidate[]
  votes             Vote[]

  @@index([current_location])
  @@index([hostel_name])
}

model Leave {
  id           String    @id @default(uuid())
  hostellerId  String
  start_date   DateTime
  end_date     DateTime
  reason       String
  status       String    @default("pending")
  approvedById String?
  createdAt    DateTime  @default(now())
  
  approvedBy   Admin?      @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  hosteller    Hosteller   @relation(fields: [hostellerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([hostellerId])
}

model ScanEvent {
  id               String    @id @default(uuid())
  hostellerId      String
  timestamp        DateTime
  type             String
  ocr_confidence   Float?
  model_confidence Float?
  camera_id        String
  createdAt        DateTime  @default(now())
  
  hosteller        Hosteller @relation(fields: [hostellerId], references: [id], onDelete: Cascade)

  @@index([hostellerId])
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  hostellerId String
  date        DateTime
  status      String
  createdAt   DateTime @default(now())
  
  hosteller   Hosteller @relation(fields: [hostellerId], references: [id], onDelete: Cascade)

  @@unique([hostellerId, date])
}

model Complaint {
  id              String    @id @default(uuid())
  hostellerId     String
  title           String
  description     String
  category        String    @default("GENERAL")
  subcategory     String?
  priority        String    @default("MEDIUM")
  image_url       String?
  status          String    @default("PENDING")
  admin_response  String?
  resolvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hosteller       Hosteller @relation(fields: [hostellerId], references: [id], onDelete: Cascade)
  resolvedBy      Admin?    @relation("ResolvedComplaints", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([hostellerId])
  @@index([category])
  @@index([priority])
}

// ── Notification System ──
model Notification {
  id          String   @id @default(uuid())
  userId      String
  userType    String
  title       String
  message     String
  type        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════════
// ELECTION / POLLING SYSTEM
// ══════════════════════════════════════════════════════════════

model Election {
  id          String     @id @default(uuid())
  title       String                              // e.g. "Hostel Committee Election 2026"
  hostel_name String                              // e.g. "Aryabhatta"
  start_date  DateTime
  end_date    DateTime
  status      String     @default("UPCOMING")     // UPCOMING, ACTIVE, ENDED
  createdById String?                             // Admin who created it
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  candidates  Candidate[]
  votes       Vote[]

  @@index([hostel_name])
  @@index([status])
}

model Candidate {
  id          String     @id @default(uuid())
  hostellerId String                              // The student who is running
  electionId  String
  position    String                              // "President", "Mess Secretary", etc.
  manifesto   String?                             // Campaign statement
  createdAt   DateTime   @default(now())

  hosteller   Hosteller  @relation(fields: [hostellerId], references: [id], onDelete: Cascade)
  election    Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@unique([hostellerId, electionId, position])   // One candidacy per position per election
  @@index([electionId, position])
}

model Vote {
  id          String     @id @default(uuid())
  voterId     String                              // Hosteller casting the vote
  candidateId String
  position    String                              // Denormalized for fast queries
  electionId  String
  createdAt   DateTime   @default(now())

  voter       Hosteller  @relation(fields: [voterId], references: [id], onDelete: Cascade)
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  election    Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([voterId, position, electionId])       // One vote per position per election
  @@index([electionId, position])
  @@index([candidateId])
}

// ══════════════════════════════════════════════════════════════
// ANNOUNCEMENT / NOTICE BOARD SYSTEM
// ══════════════════════════════════════════════════════════════

model Announcement {
  id          String     @id @default(uuid())
  title       String
  content     String
  category    String     @default("GENERAL")      // EVENT, NOTICE, URGENT, MESS, GENERAL
  priority    String     @default("NORMAL")       // NORMAL, IMPORTANT, URGENT
  hostel_name String?                             // null = all hostels
  createdById String                              // Admin who created
  expiry_date DateTime?                           // null = never expires
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy   Admin      @relation("CreatedAnnouncements", fields: [createdById], references: [id])

  @@index([hostel_name])
  @@index([category])
  @@index([priority])
  @@index([expiry_date])
}

